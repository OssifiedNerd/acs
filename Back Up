-- ==========================================
-- 5. MONEY FARM (Dungeon 28, Kill, Loot, FAST Sell, Return)
-- ==========================================
local dungeonArgs = {"\229\133\179\229\141\161\232\183\179\229\133\179\232\175\183\230\177\130", 28}
local mountArgs = {"\228\184\138\228\184\139\230\137\171\229\184\154"}
local returnArgs = {"\229\137\175\230\156\172\229\155\158\229\159\142"}
local pickupArgs = "\230\139\190\229\143\150\230\142\137\232\144\189\231\137\169"
local sellArgs = "\229\135\186\229\148\174\230\157\144\230\150\153" 

-- Added Eye of the Ice Dragon!
local itemsToPickup = {
    "Terrifying Jaws", "Sword Fern", "Plague Mushroom", 
    "Bog Muck", "Ant Head", "Spirit Leaf", 
    "Hexed Branch", "Treant Essence", "Eye of the Ice Dragon"
}

-- Target sell list (Treant Essence is safely excluded)
local itemsToSell = {
    "Terrifying Jaws", "Sword Fern", "Plague Mushroom", 
    "Bog Muck", "Ant Head", "Spirit Leaf", 
    "Hexed Branch", "Eye of the Ice Dragon"
}

local killTime = 30 
local returnWaitTime = 5 

while true do
    -- 1. Enter Dungeon 28
    remoteEvent:FireServer(unpack(dungeonArgs))
    task.wait(1)
    
    -- 2. Execute Secondary Action
    remoteFunc:InvokeServer(unpack(mountArgs))
    
    -- 3. Wait for Kill Phase
    task.wait(killTime)
    
    -- 4. Loot Phase
    local itemsLeftOnGround = true
    while itemsLeftOnGround do
        itemsLeftOnGround = false 
        
        local dropsClient = workspace:FindFirstChild("DropsClient")
        if dropsClient then
            for _, obj in ipairs(dropsClient:GetDescendants()) do
                if obj:IsA("TextLabel") and obj.Name == "ZhName" then
                    local itemText = string.lower(obj.Text)
                    for _, target in ipairs(itemsToPickup) do
                        if string.find(itemText, string.lower(target)) then
                            local idFolder = obj.Parent and obj.Parent.Parent and obj.Parent.Parent.Parent
                            if idFolder and tonumber(idFolder.Name) then
                                local args = {pickupArgs, tostring(idFolder.Name)}
                                remoteEvent:FireServer(unpack(args))
                                itemsLeftOnGround = true 
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.5) 
    end
    
    -- 5. FAST Bulk Sell Phase
    pcall(function()
        local bulkSellList = {} 
        
        -- Scan bags and gather all IDs
        for _, obj in ipairs(Players.LocalPlayer.PlayerGui:GetDescendants()) do
            if obj:IsA("TextLabel") then
                local itemText = string.lower(obj.Text)
                for _, target in ipairs(itemsToSell) do
                    if string.find(itemText, string.lower(target)) then
                        local frame = obj.Parent
                        if frame then
                            local itemID = frame:GetAttribute("OnlyID")
                            if itemID then
                                -- Add it to our array
                                table.insert(bulkSellList, tonumber(itemID))
                            end
                        end
                    end
                end
            end
        end
        
        -- Instantly sell the entire list at once using the newly discovered 'onlyIDList' format!
        if #bulkSellList > 0 then
            local payload = { ["onlyIDList"] = bulkSellList }
            remoteFunc:InvokeServer(sellArgs, payload)
            print("💰 Bulk sold " .. tostring(#bulkSellList) .. " items instantly!")
        end
    end)
    
    -- 6. Return and Reset
    remoteEvent:FireServer(unpack(returnArgs))
    task.wait(returnWaitTime)
end
