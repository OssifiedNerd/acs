-- ==========================================
-- 4. MONEY FARM (Fast Travel + Chunk Selling)
-- ==========================================
local preDungeonArgs = {"\232\131\140\229\140\133\229\183\165\229\133\183\230\160\143\229\136\135\230\141\162\230\137\139\230\140\129", {["uiSlotIndex"] = 1}}
local dungeonArgs = {"\229\133\179\229\141\161\232\183\179\229\133\179\232\175\183\230\177\130", 33}
local returnArgs = {"\229\137\175\230\156\172\229\155\158\229\159\142"}
local pickupArgs = "\230\139\190\229\143\150\230\142\137\232\144\189\231\137\169"
local sellArgs = "出售材料"

local itemsToPickup = {
    "Demon Tail", "Demon Horn", "Broken Blade", "Knight Mask", 
    "Crimson Crystal", "Infernal Rose", "Hellfire", "Nether Fruit",
    "Treant Essence"
}

local itemsToSell = {
    "Demon Tail", "Demon Horn", "Broken Blade", "Knight Mask", 
    "Crimson Crystal", "Infernal Rose", "Hellfire", "Treant Essence"
}

local killTime = 20 
local savedStageCFrame = nil 

local function findItemID(labelObj)
    local current = labelObj
    for _ = 1, 6 do
        if current then
            local attributes = current:GetAttributes()
            for k, v in pairs(attributes) do
                if string.lower(k) == "onlyid" or string.lower(k) == "id" then
                    return v
                end
            end
            
            if tonumber(current.Name) and string.len(current.Name) >= 4 then
                return current.Name
            end
            
            for _, child in ipairs(current:GetChildren()) do
                if (child:IsA("IntValue") or child:IsA("StringValue") or child:IsA("NumberValue")) 
                   and (string.lower(child.Name) == "onlyid" or string.lower(child.Name) == "id") then
                    return child.Value
                end
            end
            current = current.Parent
        end
    end
    return nil
end

while true do
    -- 1. Setup & Request Stage
    remoteEvent:FireServer(unpack(preDungeonArgs))
    task.wait(0.5)
    
    print("🧹 Requesting Stage 33...")
    remoteEvent:FireServer(unpack(dungeonArgs))
    
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        if not savedStageCFrame then
            print("🛫 First Loop: Tracking flight to learn Stage coordinates...")
            task.wait(3) 
            
            local maxWait = 30
            local elapsed = 0
            while elapsed < maxWait do
                local prevPos = hrp.Position
                task.wait(0.5)
                elapsed = elapsed + 0.5
                if (hrp.Position - prevPos).Magnitude < 1 then break end
            end
            
            print("⏳ Arrived! Waiting 5 seconds to ensure we are firmly on the ground...")
            task.wait(5) -- Adjusted to your 5 second preference
            savedStageCFrame = hrp.CFrame
        else
            print("⚡ Fast Travel: Loading map and teleporting...")
            task.wait(0.5) 
            
            -- Pre-load the area to prevent "Gameplay Paused"
            pcall(function()
                player:RequestStreamAroundAsync(savedStageCFrame.Position)
            end)
            
            local endLockTime = tick() + 1.5 
            while tick() < endLockTime do
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local currentHRP = player.Character.HumanoidRootPart
                    currentHRP.CFrame = savedStageCFrame
                    currentHRP.Velocity = Vector3.new(0, 0, 0) -- Kill weird physics momentum
                    
                    -- Force character out of the flying state
                    local humanoid = player.Character:FindFirstChild("Humanoid")
                    if humanoid then
                        humanoid:ChangeState(Enum.HumanoidStateType.Landed)
                    end
                end
                task.wait(0.05)
            end
        end
    end
    
    -- 2. Kill Phase
    print("⚔️ Farming Stage 33 mobs...")
    task.wait(killTime)
    
    -- 3. Loot Phase
    local itemsLeftOnGround = true
    while itemsLeftOnGround do
        itemsLeftOnGround = false 
        local dropsClient = workspace:FindFirstChild("DropsClient")
        if dropsClient then
            for _, obj in ipairs(dropsClient:GetDescendants()) do
                if obj:IsA("TextLabel") and obj.Name == "ZhName" then
                    local itemText = string.lower(obj.Text)
                    for _, target in ipairs(itemsToPickup) do
                        if string.find(itemText, string.lower(target)) then
                            local idFolder = obj.Parent and obj.Parent.Parent and obj.Parent.Parent.Parent
                            if idFolder and tonumber(idFolder.Name) then
                                local args = {pickupArgs, tostring(idFolder.Name)}
                                remoteEvent:FireServer(unpack(args))
                                itemsLeftOnGround = true 
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.5) 
    end
    
    -- 4. Return to Town
    print("📥 Firing Return Remote...")
    remoteEvent:FireServer(unpack(returnArgs))
    task.wait(2) 

    -- 5. CHUNK SELLING PHASE
    pcall(function()
        local bulkSellList = {} 
        local addedIDs = {} 
        
        for _, obj in ipairs(player.PlayerGui:GetDescendants()) do
            if obj:IsA("TextLabel") and obj.Text and obj.Text ~= "" then
                local itemText = string.lower(obj.Text)
                for _, target in ipairs(itemsToSell) do
                    if string.find(itemText, string.lower(target)) then
                        local itemID = findItemID(obj)
                        local numID = itemID and tonumber(itemID)
                        
                        if numID and not addedIDs[numID] then
                            addedIDs[numID] = true
                            table.insert(bulkSellList, numID)
                        end
                    end
                end
            end
        end
        
        if #bulkSellList > 0 then
            print("📦 Found " .. tostring(#bulkSellList) .. " items. Sending to server in chunks of 15...")
            local batchSize = 15 
            local successfulBatches = 0
            
            for i = 1, #bulkSellList, batchSize do
                local batch = {}
                for j = i, math.min(i + batchSize - 1, #bulkSellList) do
                    table.insert(batch, bulkSellList[j])
                end
                
                local payload = { ["onlyIDList"] = batch }
                remoteFunc:InvokeServer(sellArgs, payload)
                successfulBatches = successfulBatches + #batch
                
                print("✔️ Fired remote for a chunk of " .. tostring(#batch) .. " items...")
                task.wait(0.3) 
            end
            print("💰 Successfully sold a total of " .. tostring(successfulBatches) .. " items in the background!")
        end
    end)
    
    print("🔄 Run complete. Waiting 3 seconds before next loop.")
    task.wait(3)
end
