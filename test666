-- ==========================================
-- 5. AUTO-POTION GIFTER (Equip -> Gift)
-- ==========================================
task.spawn(function()
    local equipString = "\232\131\140\229\140\133\229\183\165\229\133\183\230\160\143\229\136\135\230\141\162\230\137\139\230\140\129"
    local giftString = "\232\181\160\233\128\129\232\175\183\230\177\130"
    local targetPlayerId = 1964437012 
    local targetPotions = {"Fire Arrow"} 
    
    while task.wait(2) do
        pcall(function()
            for _, obj in ipairs(Players.LocalPlayer.PlayerGui:GetDescendants()) do
                if obj:IsA("TextLabel") then
                    local itemText = string.lower(obj.Text)
                    for _, target in ipairs(targetPotions) do
                        if string.find(itemText, string.lower(target)) then
                            local frame = obj.Parent
                            if frame then
                                local potionID = frame:GetAttribute("OnlyID")
                                if potionID then
                                    -- 1. Equip the potion
                                    local equipArgs = {equipString, { ["onlyID"] = potionID }}
                                    remoteEvent:FireServer(unpack(equipArgs))
                                    
                                    -- Wait 0.3s for the server to process the equip
                                    task.wait(0.3)
                                    
                                    -- 2. Gift it away
                                    local giftArgs = {giftString, targetPlayerId}
                                    remoteEvent:FireServer(unpack(giftArgs))
                                    
                                    -- Short delay before grabbing the next potion to avoid spam kicks
                                    task.wait(0.3) 
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end)

-- ==========================================
-- 6. AUTO-REJOIN & COUNTDOWN (56 Minutes)
-- ==========================================
task.spawn(function()
    local minutesLeft = 56
    local elapsedMinutes = 0
    
    while minutesLeft > 0 do
        print("⏳ [AUTO-REJOIN] Time until server reset: " .. tostring(minutesLeft) .. " minutes.")
        
        if elapsedMinutes == 2 then
            pcall(function()
                local inventoryKey = Enum.KeyCode.Backquote
                VirtualInputManager:SendKeyEvent(true, inventoryKey, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, inventoryKey, false, game)
                print("🎒 [AUTO-INVENTORY] Toggled inventory open at minute 2!")
            end)
        end
        
        task.wait(60) 
        minutesLeft = minutesLeft - 1
        elapsedMinutes = elapsedMinutes + 1
    end
    
    print("🔄 [AUTO-REJOIN] 56 Minutes reached! Teleporting...")
    TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
end)

-- ==========================================
-- 7. MAIN AUTO-FARM (Spawn, Kill, Loot, Return)
-- ==========================================
local spawnArgs = {"\229\137\175\230\156\172\229\133\179\229\141\161\229\136\183\230\128\170", 1}
local pickupArgs = "\230\139\190\229\143\150\230\142\137\232\144\189\231\137\169"
local returnArgs = {"\229\137\175\230\156\172\229\155\158\229\159\142"}

local targetItems = {"Blueberry", "Withered Mushroom", "Sacred Flame", "Shadow Crystal"}
local killTime = 3 
local returnWaitTime = 5 

while true do
    remoteEvent:FireServer(unpack(spawnArgs))
    task.wait(killTime)
    
    local itemsLeftOnGround = true
    while itemsLeftOnGround do
        itemsLeftOnGround = false 
        
        local dropsClient = workspace:FindFirstChild("DropsClient")
        if dropsClient then
            for _, obj in ipairs(dropsClient:GetDescendants()) do
                if obj:IsA("TextLabel") and obj.Name == "ZhName" then
                    local itemText = string.lower(obj.Text)
                    for _, target in ipairs(targetItems) do
                        if string.find(itemText, string.lower(target)) then
                            local idFolder = obj.Parent and obj.Parent.Parent and obj.Parent.Parent.Parent
                            if idFolder and tonumber(idFolder.Name) then
                                local args = {pickupArgs, tostring(idFolder.Name)}
                                remoteEvent:FireServer(unpack(args))
                                itemsLeftOnGround = true 
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.5) 
    end
    
    remoteEvent:FireServer(unpack(returnArgs))
    task.wait(returnWaitTime)
end
