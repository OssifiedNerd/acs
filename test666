-- ==========================================
-- 5. AUTO-POTION DRINKER (Runs in background)
-- ==========================================
task.spawn(function()
    local drinkString = "\228\189\191\231\148\168\232\141\175\230\176\180"
    
    -- Add the names of any potions you want to auto-drink here!
    local targetPotions = {"Fire Arrow"} 
    
    while task.wait(2) do
        pcall(function()
            -- Scan the player's UI for inventory items
            for _, obj in ipairs(Players.LocalPlayer.PlayerGui:GetDescendants()) do
                if obj:IsA("TextLabel") then
                    
                    local itemText = string.lower(obj.Text)
                    
                    for _, target in ipairs(targetPotions) do
                        if string.find(itemText, string.lower(target)) then
                            
                            -- The parent frame (Warehouse_xxxx) holds the hidden Attribute
                            local frame = obj.Parent
                            
                            if frame then
                                -- THE MAGIC KEY: Grab the hidden OnlyID attribute directly!
                                local potionID = frame:GetAttribute("OnlyID")
                                
                                if potionID then
                                    local args = {
                                        [1] = drinkString,
                                        [2] = { ["onlyID"] = potionID }
                                    }
                                    -- Drink the potion
                                    remoteFunc:InvokeServer(unpack(args))
                                    
                                    -- Tiny delay to prevent server spam if you have 100+ potions
                                    task.wait(0.1) 
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end)

-- ==========================================
-- 6. MAIN AUTO-FARM (Spawn, Kill, Loot, Return)
-- ==========================================
local spawnArgs = {"\229\137\175\230\156\172\229\133\179\229\141\161\229\136\183\230\128\170", 1}
local pickupArgs = "\230\139\190\229\143\150\230\142\137\232\144\189\231\137\169"
local returnArgs = {"\229\137\175\230\156\172\229\155\158\229\159\142"}

local targetItems = {"Blueberry", "Withered Mushroom"}

-- Customize your kill and return times here
local killTime = 8 
local returnWaitTime = 5 

while true do
    remoteEvent:FireServer(unpack(spawnArgs))
    task.wait(killTime)
    
    local itemsLeftOnGround = true
    while itemsLeftOnGround do
        itemsLeftOnGround = false 
        
        local dropsClient = workspace:FindFirstChild("DropsClient")
        if dropsClient then
            for _, obj in ipairs(dropsClient:GetDescendants()) do
                if obj:IsA("TextLabel") and obj.Name == "ZhName" then
                    
                    local itemText = string.lower(obj.Text)
                    for _, target in ipairs(targetItems) do
                        if string.find(itemText, string.lower(target)) then
                            local idFolder = obj.Parent and obj.Parent.Parent and obj.Parent.Parent.Parent
                            if idFolder and tonumber(idFolder.Name) then
                                local args = {
                                    [1] = pickupArgs,
                                    [2] = tostring(idFolder.Name)
                                }
                                remoteEvent:FireServer(unpack(args))
                                itemsLeftOnGround = true 
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.5) 
    end
    
    remoteEvent:FireServer(unpack(returnArgs))
    task.wait(returnWaitTime)
end
