-- 1.5. HEARTBEAT ANTI-TP, CAMERA LOCK & KEYBOARD AUTO-SKIP
-- ==========================================
RunService.Heartbeat:Connect(function()
    -- 1. Anti-TP: Instantly snap back if moved
    if lockedCFrame and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        if (hrp.Position - lockedCFrame.Position).Magnitude > 5 then
            hrp.CFrame = lockedCFrame
        end
    end
    
    -- 2. Anti-Camera Hijack: Force camera to stay on your character
    local camera = workspace.CurrentCamera
    if camera.CameraType ~= Enum.CameraType.Custom then
        camera.CameraType = Enum.CameraType.Custom
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            camera.CameraSubject = player.Character.Humanoid
        end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            for _, obj in ipairs(player.PlayerGui:GetDescendants()) do
                if obj:IsA("GuiButton") and obj.Visible then
                    local isSkipButton = false
                    
                    -- Check if button or its children have the text "Skip"
                    pcall(function()
                        if obj.Text and string.find(string.lower(obj.Text), "skip") then isSkipButton = true end
                    end)
                    if not isSkipButton then
                        for _, child in ipairs(obj:GetChildren()) do
                            if child:IsA("TextLabel") and child.Text and string.find(string.lower(child.Text), "skip") then
                                isSkipButton = true
                            end
                        end
                    end
                    
                    if isSkipButton then
                        -- Method 1: Executor Force-Fire (All possible click types)
                        if firesignal then
                            pcall(function() firesignal(obj.MouseButton1Click) end)
                            pcall(function() firesignal(obj.MouseButton1Down) end)
                            pcall(function() firesignal(obj.MouseButton1Up) end)
                            pcall(function() firesignal(obj.Activated) end)
                        end
                        
                        if getconnections then
                            local events = {"MouseButton1Click", "MouseButton1Down", "MouseButton1Up", "Activated"}
                            for _, evt in ipairs(events) do
                                pcall(function()
                                    for _, conn in ipairs(getconnections(obj[evt])) do conn:Function() end
                                end)
                            end
                        end
                        
                        -- Method 2: THE KEYBOARD BYPASS (100% Native Roblox GUI interaction)
                        -- Highlights the skip button and forces the "Enter" key to press it
                        GuiService.SelectedObject = obj
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                        task.wait(0.01)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                        
                        -- Deselect after pressing
                        GuiService.SelectedObject = nil 
                        
                        print("⏭️ Keyboard Auto-Skip Triggered!")
                    end
                end
            end
        end)
    end
end)

