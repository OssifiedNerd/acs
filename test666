local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")

-- Define our Remotes
local remoteEvent = ReplicatedStorage.Msg.RemoteEvent.NetWorkRemoteEvent
local remoteFunc = ReplicatedStorage.Msg.RemoteFunction.NetWorkRemoteFunction

-- ==========================================
-- 1. ANTI-AFK SYSTEM
-- ==========================================
Players.LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
    print("Anti-AFK triggered to prevent kick!")
end)

-- ==========================================
-- 2. AUTO-CLAIM REWARDS (Runs in background)
-- ==========================================
task.spawn(function()
    while true do
        for i = 1, 12 do
            local args = {
                [1] = "\233\162\134\229\143\150\229\156\168\231\186\191\229\165\150\229\138\177",
                [2] = i
            }
            pcall(function()
                remoteFunc:InvokeServer(unpack(args))
            end)
            task.wait(0.2)
        end
        -- Waits 60 seconds before trying to claim all 12 rewards again
        task.wait(60) 
    end
end)

-- ==========================================
-- 3. AUTO-POTION MAKER (Runs in background)
-- ==========================================
task.spawn(function()
    local startArgs = {
        [1] = "\231\130\188\233\135\145\231\130\188\229\136\182",
        [2] = {["recipeId"] = 1}
    }
    local claimArgs = {
        [1] = "\231\130\188\233\135\145\230\139\190\229\143\150\230\136\144\229\147\129"
    }
    
    while true do
        -- Start the potion
        pcall(function()
            remoteFunc:InvokeServer(unpack(startArgs))
        end)
        
        -- Wait 10.5 seconds for the cooldown
        task.wait(10.5)
        
        -- Claim the potion
        pcall(function()
            remoteFunc:InvokeServer(unpack(claimArgs))
        end)
        
        -- Tiny delay before looping again to prevent spam
        task.wait(0.5) 
    end
