-- ==========================================
-- 4. AUTO-DAMAGE BOOSTER (Runs as fast as possible)
-- ==========================================
task.spawn(function()
    local damageArgs = {
        [1] = "\232\174\173\231\187\131\231\130\185\229\177\143",
        [2] = {}
    }
    
    -- task.wait() with no numbers runs as fast as the game can process it (~60 times a second)
